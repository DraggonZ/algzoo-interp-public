{"f0": "<div class=\"fig\" id=\"f0\">\n  <div class=\"ctl\"><button data-act=\"random\">New random list</button><select data-act=\"ex\"></select><span>or drag a bar up or down</span></div>\n  <svg class=\"inputs\" viewBox=\"0 0 560 210\"></svg>\n  <p class=\"cap result\"></p>\n</div>", "f1": "<div class=\"fig\" id=\"f1\">\n  <div class=\"ctl\"><button data-act=\"prev\">\u25c0 back</button><input type=\"range\" min=\"1\" max=\"10\" value=\"10\" data-act=\"step\"><button data-act=\"next\">next \u25b6</button><span class=\"steplabel\"></span></div>\n  <svg class=\"row\" viewBox=\"0 0 560 64\"></svg>\n  <div class=\"two\">\n    <svg class=\"acts\" viewBox=\"0 0 280 230\"></svg>\n    <svg class=\"scores\" viewBox=\"0 0 280 230\"></svg>\n  </div>\n  <p class=\"cap\"></p>\n</div>", "f2": "<div class=\"fig\" id=\"f2\">\n  <svg class=\"chart\" viewBox=\"0 0 560 250\"></svg>\n  <div class=\"legend\"><span><span class=\"sw\" style=\"background:var(--neutral)\"></span>largest number so far</span><span><span class=\"sw\" style=\"background:var(--series-1)\"></span>neuron 2 \u00f7 17</span><span><span class=\"sw\" style=\"background:var(--series-2);transform:rotate(45deg)\"></span>marks a step where neuron 4 fires (the marker's height means nothing; hover for its activity)</span></div>\n  <p class=\"cap\">The blue line follows the grey one a step late. It is close but not exact.</p>\n</div>", "f3": "<div class=\"fig\" id=\"f3\">\n  <svg class=\"row\" viewBox=\"0 0 560 64\"></svg>\n  <div class=\"two\">\n    <svg class=\"dial\" viewBox=\"0 0 280 280\"></svg>\n    <svg class=\"scores\" viewBox=\"0 0 280 280\"></svg>\n  </div>\n  <p class=\"cap\"></p>\n</div>", "f4": "<div class=\"fig\" id=\"f4\">\n  <div class=\"ctl\"><span>a 1.0 at position</span><input type=\"range\" min=\"0\" max=\"8\" value=\"2\" data-act=\"a\"><b class=\"av\"></b><span>event at step</span><input type=\"range\" min=\"1\" max=\"9\" value=\"6\" data-act=\"t\"><b class=\"tv\"></b></div>\n  <div class=\"ctl modes\"><button data-mode=\"none\">nothing happens</button><button data-mode=\"big\">a bigger number (1.5) arrives</button><button data-mode=\"wipe\">no bigger number: zero 1, 6, 7, 8 by hand</button><button data-mode=\"unwipe\">bigger number, but undo the wipe</button></div>\n  <svg class=\"row\" viewBox=\"0 0 560 64\"></svg>\n  <svg class=\"lower\" viewBox=\"0 0 560 110\"></svg>\n  <svg class=\"scores\" viewBox=\"0 0 560 190\"></svg>\n  <p class=\"cap\"></p>\n</div>", "f5": "<div class=\"fig\" id=\"f5\">\n  <div class=\"ctl\"><span>second-largest (position 3):</span><input type=\"range\" min=\"50\" max=\"150\" value=\"100\" data-act=\"s\"><span class=\"sval\"></span><span>number at position 6:</span><input type=\"range\" min=\"0\" max=\"140\" value=\"60\" data-act=\"v\"><span class=\"vval\"></span></div>\n  <svg class=\"row\" viewBox=\"0 0 560 64\"></svg>\n  <div class=\"two\">\n    <svg class=\"gate\" viewBox=\"0 0 280 240\"></svg>\n    <svg class=\"scores\" viewBox=\"0 0 280 240\"></svg>\n  </div>\n  <p class=\"cap\"></p>\n</div>", "f6": "<div class=\"fig\" id=\"f6\">\n  <div class=\"ctl\"><span>bigger (1.5) at position</span><input type=\"range\" min=\"0\" max=\"9\" value=\"1\" data-act=\"p1\"><b class=\"p1v\"></b><span>smaller (1.0) at position</span><input type=\"range\" min=\"0\" max=\"9\" value=\"4\" data-act=\"p2\"><b class=\"p2v\"></b></div>\n  <svg class=\"grid\" viewBox=\"0 0 560 350\"></svg>\n  <p class=\"cap\"></p>\n</div>", "f7": "<div class=\"fig\" id=\"f7\">\n  <div class=\"ctl\"><span>list:</span><select data-act=\"ex\"></select><span>vary the number at position</span><select data-act=\"pos\"></select></div>\n  <svg class=\"sweep\" viewBox=\"0 0 560 270\"></svg>\n  <div class=\"legend\"><span><span class=\"sw\" style=\"background:var(--series-1)\"></span>network's answer</span><span><span class=\"sw\" style=\"background:var(--neutral)\"></span>right answer</span></div>\n  <p class=\"cap\"></p>\n</div>", "f8": "<div class=\"fig\" id=\"f8\">\n  <svg class=\"weights\" viewBox=\"0 0 600 470\"></svg>\n  <p class=\"cap\"></p>\n</div>", "f9": "<div class=\"fig\" id=\"f9\">\n  <div class=\"ctl\"><select data-act=\"model\"><option value=\"arc\">ARC's trained network</option><option value=\"hb\">hand-built network</option></select><button data-act=\"random\">New random list</button><select data-act=\"ex\"></select><button data-act=\"prev\">\u25c0</button><input type=\"range\" min=\"1\" max=\"10\" value=\"10\" data-act=\"step\"><button data-act=\"next\">\u25b6</button><span class=\"steplabel\"></span><button data-act=\"restore\">switch all back on</button></div>\n  <svg class=\"inputs\" viewBox=\"0 0 560 190\"></svg>\n  <ul class=\"events\"></ul>\n  <svg class=\"scores\" viewBox=\"0 0 560 190\"></svg>\n  <p class=\"cap result\"></p>\n  <svg class=\"heat\" viewBox=\"0 0 560 420\"></svg>\n  <details><summary>Table of all activities</summary><div class=\"table\"></div></details>\n</div>"}